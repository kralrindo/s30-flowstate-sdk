+// Raw v20 export: the pak blobs as stored. The .vg is the starpak entry as is
+// (groups still compressed; rmdlconv decompresses), the .vg_static the resident copy.
+static bool ExportRawModelAssetV20(CPakAsset* const pakAsset, const ModelRawV20_t& raw)
+{
+    const ModelAssetHeader_v16_t* const hdr = raw.hdr;
+    const ModelAssetCPU_v16_t* const cpu = raw.cpu;
+
+    if (!hdr->name || !hdr->data || !cpu || cpu->dataSizeModel <= 0)
+    {
+        printf("WARNING: model v20 0x%llX has no studiohdr data; skipped.\n", (unsigned long long)pakAsset->GetAssetGUID());
+        return false;
+    }
+
+    std::filesystem::path exportPath = g_ExportSettings.GetExportDirectory();
+    const std::filesystem::path modelPath(hdr->name);
+
+    if (g_ExportSettings.exportPathsFull)
+        exportPath.append(modelPath.parent_path().string());
+    else
+        exportPath.append(std::format("{}/{}", s_AssetTypePaths.find(AssetType_t::MDL_)->second, modelPath.stem().string()));
+
+    if (!CreateDirectories(exportPath))
+        return false;
+
+    exportPath.append(std::format("{}.rmdl", modelPath.stem().string()));
+
+    StreamIO studioOut(exportPath.string(), eStreamIOMode::Write);
+    studioOut.write(reinterpret_cast<const char*>(hdr->data), cpu->dataSizeModel);
+    studioOut.close();
+
+    if (cpu->physics && cpu->dataSizePhys > 0)
+    {
+        exportPath.replace_extension(".phy");
+        StreamIO physOut(exportPath.string(), eStreamIOMode::Write);
+        physOut.write(reinterpret_cast<const char*>(cpu->physics), cpu->dataSizePhys);
+    }
+
+    exportPath.replace_extension(".rson");
+    StreamIO depOut(exportPath.string(), eStreamIOMode::Write);
+    WriteRSONDependencyArray(*depOut.W(), "rigs", hdr->animRigs, hdr->numAnimRigs);
+    WriteRSONDependencyArray(*depOut.W(), "seqs", hdr->animSeqs, hdr->numAnimSeqs);
+    depOut.close();
+
+    if (hdr->staticStreamingData && hdr->streamingDataSize)
+    {
+        exportPath.replace_extension(".vg_static");
+        StreamIO staticOut(exportPath.string(), eStreamIOMode::Write);
+        staticOut.write(hdr->staticStreamingData, hdr->streamingDataSize);
+    }
+
+    if (raw.streamEntry.size)
+    {
+        const std::unique_ptr<char[]> streamedData = pakAsset->getStarPakData(raw.streamEntry.offset, raw.streamEntry.size, false);
+        if (streamedData)
+        {
+            exportPath.replace_extension(".vg");
+            StreamIO vgOut(exportPath.string(), eStreamIOMode::Write);
+            vgOut.write(streamedData.get(), raw.streamEntry.size);
+        }
+        else
+            printf("WARNING: model v20 '%s' streamed vertex data not found (starpak missing?).\n", hdr->name);
+    }
+
+    return true;
+}
