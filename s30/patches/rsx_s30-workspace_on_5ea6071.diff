diff --git a/src/game/rtech/assets/texture_extra.cpp b/src/game/rtech/assets/texture_extra.cpp
new file mode 100644
index 0000000..67baadf
--- /dev/null
+++ b/src/game/rtech/assets/texture_extra.cpp
@@ -0,0 +1,102 @@
+#include "pch.h"
+
+#include <game/rtech/cpakfile.h>
+#include <game/rtech/utils/utils.h>
+
+extern ExportSettings_t g_ExportSettings;
+
+// Re-packable .txtx container read by RePak's AddTextureExtraAsset_v2:
+//   u32 magic 'TXTX', u32 format, u32 count, u32 dataLen, u8 data[dataLen].
+#define TXTX_FILE_MAGIC 0x54585854u
+
+// txtx v2 header: two u32 fields, then a pointer to the data blob.
+struct TextureExtraAssetHeader_v2_t
+{
+    uint32_t format;
+    uint32_t count;
+    const char* data;
+};
+
+// The blob length is not stored. Per-cubemap ambient data (format 1, see BSP lump
+// CUBEMAPS_AMBIENT_RCP) is a float4 per entry; the RGBA8 table (format 0x100000) is
+// 64 bytes per entry. Any other format is refused rather than guessed.
+static size_t GetTextureExtraDataSize(const TextureExtraAssetHeader_v2_t* const hdr)
+{
+    switch (hdr->format)
+    {
+    case 0x1:
+        return static_cast<size_t>(hdr->count) * 16;
+    case 0x100000:
+        return static_cast<size_t>(hdr->count) * 64;
+    default:
+        return 0;
+    }
+}
+
+void LoadTextureExtraAsset(CAssetContainer* const container, CAsset* const asset)
+{
+    UNUSED(container);
+
+    CPakAsset* pakAsset = static_cast<CPakAsset*>(asset);
+
+    // [rika]: has no name var
+    pakAsset->SetAssetNameFromCache();
+}
+
+bool ExportTextureExtraAsset(CAsset* const asset, const int setting)
+{
+    UNUSED(setting);
+
+    CPakAsset* pakAsset = static_cast<CPakAsset*>(asset);
+    const TextureExtraAssetHeader_v2_t* const hdr = reinterpret_cast<const TextureExtraAssetHeader_v2_t*>(pakAsset->header());
+
+    const size_t dataSize = GetTextureExtraDataSize(hdr);
+    if (dataSize == 0 || !hdr->data)
+    {
+        printf("[TXTX] asset 0x%llX has unknown format 0x%X (count %u); not exported\n", asset->GetAssetGUID(), hdr->format, hdr->count);
+        return false;
+    }
+
+    std::filesystem::path exportPath = g_ExportSettings.GetExportDirectory();
+    const std::filesystem::path txtxPath(asset->GetAssetName());
+
+    if (g_ExportSettings.exportPathsFull)
+        exportPath.append(txtxPath.parent_path().string());
+    else
+        exportPath.append("txtx");
+
+    if (!CreateDirectories(exportPath))
+    {
+        assertm(false, "Failed to create asset type directory.");
+        return false;
+    }
+
+    exportPath.append(txtxPath.filename().string());
+    exportPath.replace_extension("txtx");
+
+    StreamIO txtxOut(exportPath.string(), eStreamIOMode::Write);
+
+    const uint32_t fileHdr[4] = { TXTX_FILE_MAGIC, hdr->format, hdr->count, static_cast<uint32_t>(dataSize) };
+    txtxOut.write(reinterpret_cast<const char*>(fileHdr), sizeof(fileHdr));
+    txtxOut.write(hdr->data, dataSize);
+
+    txtxOut.close();
+
+    return true;
+}
+
+void InitTextureExtraAssetType()
+{
+    AssetTypeBinding_t type =
+    {
+        .name = "Texture Extra",
+        .type = 'xtxt',
+        .headerAlignment = 8,
+        .loadFunc = LoadTextureExtraAsset,
+        .postLoadFunc = nullptr,
+        .previewFunc = nullptr,
+        .e = { ExportTextureExtraAsset, 0, nullptr, 0ull },
+    };
+
+    REGISTER_TYPE(type);
+}
