diff --git a/src/studio/studio_r5_v16.h b/src/studio/studio_r5_v16.h
index 16fd105..c3788d9 100644
--- a/src/studio/studio_r5_v16.h
+++ b/src/studio/studio_r5_v16.h
@@ -17,9 +17,15 @@
 #pragma once
 #include <studio/studio.h>
 
-// Macro for offset conversion - v16 uses direct byte offsets
+// The engine decodes a v16+ u16 studio offset as (o & 0xFFFE) << (4 * (o & 1)): the low bit
+// is a x16 scale flag, which is how a 16-bit field reaches past 64 KB (RSX decodes the same
+// way). The identity this replaced misread every scaled field -- e.g. a v17 intermediate's
+// bvhOffset 0x11F7 (= 0x11F60) sent the collision walk into the bone data. 32-bit offsets
+// stay plain byte offsets.
 #ifndef FIX_OFFSET
-#define FIX_OFFSET(x) (x)
+inline size_t StudioFixOffset(const uint16_t o) { return static_cast<size_t>(o & 0xFFFE) << (4 * (o & 1)); }
+template <typename T> inline T StudioFixOffset(const T o) { return o; }
+#define FIX_OFFSET(x) StudioFixOffset(x)
 #endif
 
 #pragma pack(push, 2)
