+// Guids whose references are written but not registered as pak dependencies, from the
+// build list's "unregisteredRefsFile": assets of types the target runtime cannot load
+// (S30 odla/odlp/wepn named by settings, for the S3 dedi), which would otherwise be
+// unresolved deps on every load.
+extern std::unordered_set<PakGuid_t> g_unregisteredGuidRefs;
+
 // if the asset already existed, the function will return true.
-inline bool Pak_RegisterGuidRefAtOffset(const PakGuid_t guid, const size_t offset, 
+inline bool Pak_RegisterGuidRefAtOffset(const PakGuid_t guid, const size_t offset,
 	PakPageLump_s& chunk, PakAsset_t& asset)
 {
 	// NULL guids should never be added. we check it here because otherwise we
@@ -230,6 +236,15 @@ inline bool Pak_RegisterGuidRefAtOffset(const PakGuid_t guid, const size_t offse
 	if (guid == 0)
 		return false;
 
+	// The runtime turns a registered slot into a pointer, and NULLs one it cannot resolve;
+	// an unregistered slot keeps whatever is written, so write that NULL here.
+	if (g_unregisteredGuidRefs.contains(guid))
+	{
+		if (chunk.data && offset + sizeof(PakGuid_t) <= static_cast<size_t>(chunk.size))
+			*reinterpret_cast<PakGuid_t*>(chunk.data + offset) = 0;
+		return false;
+	}
+
 	asset.AddGuid(chunk.GetPointer(offset), guid);
 	return true;
 }
